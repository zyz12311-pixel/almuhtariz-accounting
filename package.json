{
  "name": "almuhtariz-accounting",
  "version": "0.10.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "asn1js": "4.1.0",
    "xadesjs": "3.1.0",
    "xmldsigjs": "3.1.0",
    "xpath": "0.0.35"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "playwright": "^1.45.0"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "test": "node --no-warnings tests/run.js",
    "license:keygen": "node tools/make-license.js keygen",
    "license:sign": "node tools/make-license.js sign",
    "test:safety": "node --no-warnings tests/safety.js",
    "build:zatca-xmlsec": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-zatca-xmlsec.ps1",
    "build:zatca-deps": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fetch-zatca-deps.ps1",
    "test:zatca-c14n-sdk": "node --no-warnings tests/zatca-c14n-sdk.js",
    "init:local": "node --no-warnings tools/init-local.js",
    "compliance:samples": "node --no-warnings tools/generate-compliance-samples.js",
    "compliance:sdk": "node tools/run-official-sdk.js",
    "electron:dev": "concurrently -k -s first \"npm start\" \"wait-on http://127.0.0.1:3113 && electron electron/main.cjs\"",
    "electron:build": "electron-builder --win --x64",
    "electron:pack": "electron-builder --win --x64 --dir",
    "test:e2e": "playwright test tests/e2e-electron.test.cjs"
  },
  "build": {
    "appId": "com.almuhtariz.accounting",
    "productName": "المحترز للمحاسبة",
    "copyright": "Copyright © 2024 المحترز",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "server/**/*",
      "web/**/*",
      "electron/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools/zatca-lib",
        "to": "zatca-lib",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "server/zatca/java/build",
        "to": "zatca-java",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/almuhtariz-logo.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "المحترز للمحاسبة",
      "uninstallDisplayName": "المحترز للمحاسبة وإدارة الأعمال",
      "license": "assets/license.txt",
      "installerIcon": "assets/almuhtariz-logo.ico",
      "uninstallerIcon": "assets/almuhtariz-logo.ico",
      "runAfterFinish": true
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
